# Database
DB_PASSWORD=contextify
DATABASE_URL=postgresql+asyncpg://contextify:contextify@localhost:5432/contextify

# API
# DEFAULT_API_SECRET_KEY in config.py is the sentinel checked by the
# hosted-mode boot guard; production must override this with a random secret.
API_SECRET_KEY=dev-secret-change-me
ENABLE_DOCS=false
ENABLE_REGISTRATION=false

# Browser auth
# Hosted production must set FORCE_SECURE_COOKIES=true. Local/self-hosted
# HTTP development may leave it false only when SELF_HOSTED=true.
JWT_TOKEN_EXPIRE_HOURS=24
REAUTH_WINDOW_MINUTES=15
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=180
FORCE_SECURE_COOKIES=false
ALLOW_MULTI_MEMBERSHIP_ACCOUNTS=false

# Transactional email (Resend)
# When RESEND_API_KEY is empty, auth email delivery is faked through logs.
# Hosted production (SELF_HOSTED=false) refuses to boot unless this is set.
RESEND_API_KEY=
EMAIL_FROM=noreply@contextify.sh
EMAIL_REPLY_TO=support@contextify.sh
EMAIL_BASE_URL=http://localhost:8443
AUTH_EMAIL_DELIVERY_MAX_ATTEMPTS=3
AUTH_EMAIL_RETRY_DELAY_SECONDS=300
AUTH_EMAIL_OUTBOX_INTERVAL_SECONDS=60
TOS_VERSION=2026-04-24

# SMTP fallback (optional; invitations are logged when not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@contextify.sh

# Invitations
INVITATION_BASE_URL=http://localhost:8443
INVITATION_EXPIRY_DAYS=7

# Self-hosted mode (disables billing features and permits local HTTP cookies)
SELF_HOSTED=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://contextify.sh

# Logging
LOG_LEVEL=info
LOG_FORMAT=text

# Error monitoring
ERROR_MONITORING_ENABLED=false
ERROR_MONITORING_SEND_DEFAULT_PII=false
ERROR_MONITORING_MAX_EVENTS_PER_MINUTE=20
OPS_SMOKE_TOKEN=
SUPPORT_ADMIN_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_ERROR_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=
SENTRY_DEBUG=false

# Sync limits
MAX_BATCH_SIZE=5000
MAX_ENTRY_CONTENT_BYTES=1000000
MAX_REQUEST_BODY_BYTES=50000000
IDEMPOTENCY_TTL_HOURS=24
SESSION_TTL_HOURS=24

# Rate limiting (requests per minute, per API key; 0 = disabled)
RATE_LIMIT_SYNC_PER_MINUTE=120
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# Unauthenticated endpoint rate limits (per IP, requests per minute; 0 = disabled)
RATE_LIMIT_UNAUTH_REGISTER_PER_MINUTE=5
RATE_LIMIT_UNAUTH_LOGIN_PER_MINUTE=10
RATE_LIMIT_UNAUTH_DEVICE_CODE_PER_MINUTE=10
RATE_LIMIT_UNAUTH_DEVICE_TOKEN_PER_MINUTE=30
RATE_LIMIT_UNAUTH_INVITATION_ACCEPT_PER_MINUTE=10

# Device flow (RFC 8628)
DEVICE_CODE_EXPIRY_SECONDS=900
DEVICE_POLL_INTERVAL=5

# Data retention (days, 0 = no auto-deletion)
DEFAULT_DATA_RETENTION_DAYS=0

# Purge scheduling (delete-account flow; sweep tombstones, etc.)
PURGE_GRACE_PERIOD_DAYS=30
PURGE_CHECK_INTERVAL_SECONDS=3600
PURGE_TOMBSTONE_RETENTION_MONTHS=12
PURGE_BATCH_LIMIT=5
